<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.live.model.dao.MemberDao">

  <!-- TODO: 03-2. MemberDao에 대한 insert를 작성해보세요. -->
  <insert id="insert" keyProperty="mno" useGeneratedKeys="true"> INSERT INTO member (name, email,
    password) VALUES (#{name}, #{email}, #{password}) </insert>

  <!-- TODO: 04-1. update, delete, updateProfile에 대한 코드를 확인하세요.  -->
  <update id="update"> UPDATE member SET name = #{name}, role = #{role} WHERE email = #{email} </update>

  <update id="updatePassword"> UPDATE member SET password = #{password} WHERE email = #{email} </update>

  <update id="updateProfile"> UPDATE member SET profile = #{profile} WHERE email = #{email} </update>

  <update id="updateRefresh"> UPDATE member SET refresh = #{refresh} WHERE email = #{email} </update>

  <update id="updateOauthInfo"> UPDATE member SET oauth_provider = #{oauthProvider}, oauth_id =
    #{oauthId} WHERE email = #{email} </update>

  <delete id="delete"> DELETE FROM member WHERE mno = #{mno} </delete>


  <!-- TODO: 06-1. Member select(String email)에 대한 코드를 확인하세요.  -->
  <select id="select" resultType="Member"> SELECT * FROM member WHERE email = #{email} </select>

  <!-- TODO: 07-1. Member에 대한 기본 resultMap을 만들고 이를 이용해서 List<Member> searchAll()를 처리하세요. -->
  <!--
  mno에 대한 내림 차순으로 정렬한다. -->
  <select id="searchAll" resultMap="memberMap"> SELECT * FROM member ORDER BY mno DESC </select>

  <resultMap id="memberMap" type="Member" autoMapping="true">
    <id property="mno" column="mno" />
  </resultMap>

  <!-- TODO: 09-1. Member selectDetail(String email)을 처리해보세요. -->
  <select id="selectDetail" resultMap="memberAddressMap"> SELECT m.*, a.* FROM member m LEFT JOIN
    address a USING (mno) WHERE email = #{email} </select>

  <resultMap id="memberAddressMap" type="Member" extends="memberMap" autoMapping="true">
    <collection property="addresses"
      column="mno"
      ofType="Address"
      notNullColumn="ano"
      resultMap="com.ssafy.live.model.dao.AddressDao.addressMap" />
  </resultMap>

  <!-- TODO: 15-1. int getTotalCount(SearchCondition condition)를 처리해보세요. -->
  <!--  이때 sql 태그를 통해 공통 쿼리를 작성한다. -->
  <select id="getTotalCount"> SELECT COUNT(mno) FROM member <include refid="searchCondition"></include>
  </select>

  <sql id="searchCondition">
    <where>
      <if test="key == 'name' and word != null"> name LIKE CONCAT('%', #{word}, '%') </if>
      <if
        test="key == 'email' and word != null"> email LIKE CONCAT('%', #{word}, '%') </if>
    </where>
  </sql>
  <!-- TODO: 15-3. List<Member> search(SearchCondition condition)를 처리해보세요. -->
  <select id="search"> SELECT * FROM member <include refid="searchCondition"></include> ORDER BY mno
    DESC LIMIT #{offset}, #{itemsPerPage} </select>
</mapper>
