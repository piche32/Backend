<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.live.model.dao.AddressDao">

  <insert id="insert" useGeneratedKeys="true" keyProperty="ano"> INSERT INTO address (mno, title,
    address, detail_address, x, y) VALUES (#{mno}, #{title}, #{address}, #{detailAddress}, #{x},
    #{y}) </insert>

  <delete id="delete"> DELETE FROM address WHERE ano = #{ano} </delete>

  <delete id="deleteByMno"> DELETE FROM address WHERE mno = #{mno} </delete>

  <select id="select" resultMap="addressMap">
    <!-- select * from address where ano=#{ano} --> SELECT ano, mno, title, address, detail_address, x, y
    FROM address WHERE ano = #{ano} </select>

  <select id="selectDetail" resultMap="addressMemberMap"> SELECT a.*, m.* FROM address a JOIN member
    m USING (mno) WHERE ano = #{ano} </select>

  <select id="queryStructureChange" resultMap="addressMap"> SELECT * FROM address WHERE ${key} =
    #{word} </select>

  <select id="dynamicSelect" resultMap="addressMap"> SELECT * FROM address <trim prefix="where"
      prefixOverrides="or|and">
      <if test="title != null"> AND title = #{title} </if>
      <if test="mno != null"> AND mno = #{mno} </if>
    </trim>
  </select>

  <select id="selectUseIn" resultMap="addressMap"> SELECT * FROM address <where>
      <foreach collection="titles" item="title" open="title in (" separator="," close=")"> #{title} </foreach>
    </where>
  </select>

  <update id="dynamicUpdate"> UPDATE address <trim prefix="set" suffixOverrides=",">
      <if test="mno != null">mno = #{mno},</if>
      <if test="title != null">title = #{title},</if>
      <if
        test="address != null">address = #{address},</if>
      <if test="detailAddress != null">detail_address
    = #{detailAddress},</if>
      <if test="x != null">x = #{x},</if>
      <if test="y != null">y = #{y},</if>
    </trim>
    WHERE ano = #{ano} </update>

  <resultMap type="Address" id="addressMap" autoMapping="true">
    <id column="ano" property="ano" />
    <result column="detail_address" property="detailAddress" />
  </resultMap>

  <resultMap type="Address" id="addressMemberMap" extends="addressMap" autoMapping="true">
    <association property="member"
      column="mno"
      resultMap="com.ssafy.live.model.dao.MemberDao.memberMap" />
  </resultMap>
</mapper>
